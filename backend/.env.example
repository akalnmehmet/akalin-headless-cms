# Django
SECRET_KEY=your-secret-key-here-minimum-50-characters-long
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Veritabanı (Production - PostgreSQL)
DB_NAME=portfolyo_db
DB_USER=portfolyo
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# AWS S3 (Production)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=eu-central-1
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# Redis (Opsiyonel)
REDIS_URL=redis://localhost:6379/0

# E-posta — Resend SMTP (ücretsiz tier)
# Resend dashboard: https://resend.com/api-keys
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=onboarding@resend.dev
CONTACT_EMAIL=mehmetakalin660@gmail.com
